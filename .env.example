DATABASE_URL=postgres://syngmb:syngmb@localhost:54329/syngmb
# Tests only: a separate, throwaway database.
DATABASE_URL_TEST=postgres://syngmb:syngmb@localhost:54329/syngmb_test
BETTER_AUTH_SECRET=replace-with-random-string
BETTER_AUTH_URL=http://localhost:3000
# 32 bytes, base64 (openssl rand -base64 32)
ENCRYPTION_KEY=replace-with-base64-32-bytes
# 32+ bytes, base64 (openssl rand -base64 32). Signs audit chain-head checkpoints; do not reuse ENCRYPTION_KEY.
AUDIT_CHECKPOINT_KEY=replace-with-base64-32-bytes
# First start only: creates the organization and its owner when the database has none. After that the
# owner changes the password in the app and these values are ignored. Password: 8 to 128 characters.
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional. Name of the first organization (default "My agency").
OWNER_ORG_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# mock (default) or live. Live needs Google Basic Access approval for the Business Profile APIs; keep mock until then.
GOOGLE_BUSINESS_API_MODE=mock
# Live mode only: unset/off refuses every Google write (read-only go-live); live lets writes through.
GOOGLE_BUSINESS_WRITES=
# Browser key for the Maps JavaScript API (rank map). Restrict it by HTTP referrer to this app's
# domains and to "Maps JavaScript API" only. Empty = the rank map shows a placeholder and the table.
GOOGLE_MAPS_BROWSER_KEY=
MCP_PORT=3100
# Public MCP endpoint people paste into their AI client (full URL, https only). The web app serves it at /mcp on
# its own domain and passes requests on to the MCP service, so this is <web domain>/mcp, e.g. https://app.example.com/mcp.
# Empty in production = the AI agents page says the MCP server has no public address. Dev default: http://localhost:$MCP_PORT/mcp.
MCP_PUBLIC_URL=
# Where the web app reaches the MCP service (web only; no path). Default http://localhost:$MCP_PORT. In Docker use the
# MCP container's name on the shared network, e.g. http://mcp:3100.
MCP_INTERNAL_URL=
WORKER_PORT=3200
# Public base URL of the worker, used to build DataForSEO pingback URLs (geo-grid). Must be reachable by DataForSEO.
WORKER_PUBLIC_URL=http://localhost:3200
# Pub/Sub authenticated push (Business Profile notifications). Audience = the value set on the push
# subscription; email = the service account its OIDC token is minted for. Empty = webhook answers 503.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Full topic name (projects/<project>/topics/<topic>) the app registers with Google for review notifications.
PUBSUB_TOPIC=
# Email via Resend (daily digest and report emails). Empty key = digest skipped (logged, nothing sent).
# EMAIL_FROM must be on a sending domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="OpenGMB <notifications@example.com>"

# Push alerts to installed browsers (X4). All three empty = the feature is hidden and nothing is sent.
# Generate the pair with: npx web-push generate-vapid-keys --json. SUBJECT is a mailto: or https: contact.
# Set the same values on the web app and the worker. Never change the pair after people subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Abuse protection. All optional; the defaults are the values below.
# Per-account sign-in lockout: this many wrong passwords for one email inside the window locks it
# until the window ends (10 failures, 15 minutes).
AUTH_LOCKOUT_FAILURES=
AUTH_LOCKOUT_MINUTES=
# Per-IP requests per minute on the public pages: share links /r/ (60), review links /go/ (60) and
# library images /m/ (300). WEB_PROXY_HOPS = reverse proxies in front of web (1).
PUBLIC_SHARE_PER_MINUTE=
PUBLIC_REVIEW_LINK_PER_MINUTE=
PUBLIC_IMAGE_PER_MINUTE=
WEB_PROXY_HOPS=

# Monitoring (H2). Where error, worker-down and (via deploy/selfhost/uptime-check.sh) site-down alerts
# are emailed, using the Resend settings above. Empty = alerts are only logged as "[alert] ...".
ALERT_EMAIL=

# --- AI, rank tracking and images (optional, your own keys) ---
# Each feature is switched off until its key is set, and the rest of the app keeps working.
# Anthropic key for built-in AI drafts, review replies and report summaries.
ANTHROPIC_API_KEY=
# DataForSEO API login and API password (not your account password) for rank tracking.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Pixabay key for stock photos on posts.
PIXABAY_API_KEY=
# OpenAI key for AI-generated post images.
OPENAI_API_KEY=
