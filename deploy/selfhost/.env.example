# Copy to .env in this folder and fill in. Placeholders only: never commit a real .env.
# Generate secrets with openssl as shown. See SETUP.md at the repository root.

# --- Required ---------------------------------------------------------------------------
# Database password for the bundled postgres (openssl rand -hex 24). Letters and digits only
# is safest because it is placed inside a connection URL.
POSTGRES_PASSWORD=replace-with-random-hex
# Public URL of the web app, no trailing slash. Also the Google OAuth redirect base.
WEB_URL=http://localhost:8080
# Session signing secret (openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-random-string
# Encrypts stored secrets (Google refresh tokens, DataForSEO keys): base64 for exactly 32 bytes
# (openssl rand -base64 32). Losing or changing it makes stored secrets unreadable.
ENCRYPTION_KEY=replace-with-base64-32-bytes
# Signs audit chain-head checkpoints (openssl rand -base64 32). Different from ENCRYPTION_KEY.
AUDIT_CHECKPOINT_KEY=replace-with-base64-32-bytes
# First start only: creates the organization and its owner when the database has none. After that the
# owner changes the password in the app and these values are ignored. Password: 8 to 128 characters.
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional. Name of the first organization (default "My agency").
OWNER_ORG_NAME=
# Public base URL of the worker, reachable by Google Pub/Sub and DataForSEO (via your reverse proxy).
WORKER_PUBLIC_URL=http://localhost:8082

# --- Host ports (the apps always listen on 3000 / 3100 / 3200 inside their containers) ---
WEB_HOST_PORT=8080
MCP_HOST_PORT=8081
WORKER_HOST_PORT=8082

# --- Google (your own Google Cloud project; see SETUP.md) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# mock (default) or live. Live needs Business Profile API access approved for your project.
GOOGLE_BUSINESS_API_MODE=mock
# Optional. Maps JavaScript API browser key for the rank map, restricted by referrer to WEB_URL.
# Read at request time: set it and restart web, no rebuild. Empty = placeholder plus table.
GOOGLE_MAPS_BROWSER_KEY=
# Instant review alerts (Pub/Sub push to <WEB_URL>/webhooks/google-pubsub). All three are needed: the full topic name
# (projects/<project>/topics/<topic>), the audience set on the push subscription, and the service account it signs as.
PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=

# --- Email (Resend) ----------------------------------------------------------------------
# Empty key = the daily digest is skipped. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="OpenGMB <notifications@example.com>"

# --- AI, rank tracking and images (optional, your own keys) -------------------------------
# Each feature is switched off until its key is set, and the rest of the app keeps working.
# Anthropic key for built-in AI drafts, review replies and report summaries.
ANTHROPIC_API_KEY=
# DataForSEO API login and API password (not your account password) for rank tracking.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Pixabay key for stock photos on posts.
PIXABAY_API_KEY=
# OpenAI key for AI-generated post images.
OPENAI_API_KEY=

# --- Push alerts (optional) --------------------------------------------------------------
# Alerts on installed browsers for new reviews and approvals. All three empty = the feature is
# hidden. Generate the pair: npx web-push generate-vapid-keys --json. SUBJECT: mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
