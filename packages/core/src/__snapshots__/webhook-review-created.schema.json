{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "review.created"
    },
    "test": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "review": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "workspaceName": {
              "type": "string"
            },
            "locationId": {
              "type": "string"
            },
            "locationName": {
              "type": "string"
            },
            "googleReviewName": {
              "type": "string"
            },
            "starRating": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewerName": {
              "type": [
                "string",
                "null"
              ]
            },
            "createTime": {
              "type": "string"
            },
            "updateTime": {
              "type": "string"
            },
            "appUrl": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "workspaceId",
            "workspaceName",
            "locationId",
            "locationName",
            "googleReviewName",
            "starRating",
            "comment",
            "reviewerName",
            "createTime",
            "updateTime",
            "appUrl"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "review"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "test",
    "createdAt",
    "data"
  ],
  "additionalProperties": false
}
