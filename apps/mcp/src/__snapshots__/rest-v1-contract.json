                ]
              },
              "senderPostalAddress": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "senderCompanyNumber": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "senderPhone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "senderWebsite": {
                "type": [
                  "string",
