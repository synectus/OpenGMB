              },
              "dateFormat": {
                "type": "string",
                "enum": [
                  "YYYY-MM-DD",
                  "DD/MM/YYYY",
                  "MM/DD/YYYY"
                ]
              },
              "senderLegalName": {
                "type": [
                  "string",
