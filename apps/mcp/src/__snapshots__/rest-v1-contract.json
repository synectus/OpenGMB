                ]
              },
              "hipaaCoveredEntity": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "defaultPostLanguage",
              "timeZone",
              "timeZoneSource",
              "dateFormat",
              "senderLegalName",
              "senderPostalAddress",
              "senderCompanyNumber",
              "senderPhone",
              "senderWebsite",
              "hipaaCoveredEntity",
              "createdAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "workspaces"
      ],
      "additionalProperties": false
    }
  },
  "webhooks.subscribe": {
    "kind": "write",
    "approval": "own_flow",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "events": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "review.created"
            ]
          }
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "url"
      ]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "subscription": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workspaceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "disabled"
              ]
            },
            "disabledReason": {
              "type": [
                "string",
                "null"
              ]
            },
            "consecutiveFailures": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "createdAt": {
              "type": "string"
            },
            "lastDelivery": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "statusCode": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "at": {
                      "type": "string"
                    },
                    "test": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "statusCode",
                    "at",
                    "test"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "url",
            "events",
            "workspaceId",
            "description",
            "status",
            "disabledReason",
            "consecutiveFailures",
            "createdAt",
            "lastDelivery"
          ],
          "additionalProperties": false
        },
        "secret": {
          "type": "string"
        }
      },
      "required": [
        "subscription",
        "secret"
      ],
      "additionalProperties": false
    }
  },
  "webhooks.unsubscribe": {
    "kind": "write",
    "approval": "own_flow",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "id"
      ]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  "review.created payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "review.created"
      },
      "test": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "properties": {
          "review": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "workspaceId": {
                "type": "string"
              },
              "workspaceName": {
                "type": "string"
              },
              "locationId": {
                "type": "string"
              },
              "locationName": {
                "type": "string"
              },
              "googleReviewName": {
                "type": "string"
              },
              "starRating": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "comment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewerName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "createTime": {
                "type": "string"
              },
              "updateTime": {
                "type": "string"
              },
              "appUrl": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "workspaceId",
              "workspaceName",
              "locationId",
              "locationName",
              "googleReviewName",
              "starRating",
              "comment",
              "reviewerName",
              "createTime",
              "updateTime",
              "appUrl"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "review"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "type",
      "test",
      "createdAt",
      "data"
    ],
    "additionalProperties": false
  }
}
